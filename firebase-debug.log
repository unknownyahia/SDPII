[debug] [2026-05-06T10:52:28.814Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/spots-42d51/rulesets {"name":"projects/spots-42d51/rulesets/a2f4aaf7-bd08-449a-b2c6-4f6dec9fd860","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function userDoc(userId) {\n      return get(/databases/$(database)/documents/users/$(userId));\n    }\n\n    function currentUserDoc() {\n      return userDoc(request.auth.uid);\n    }\n\n    function isSelf(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function isAdmin() {\n      return isSignedIn() && currentUserDoc().data.role == 'admin';\n    }\n\n    function isSelfOrAdmin(userId) {\n      return isSelf(userId) || isAdmin();\n    }\n\n    function optionalFieldUnchanged(fieldName) {\n      return (\n        !(fieldName in resource.data) &&\n        !(fieldName in request.resource.data)\n      ) || (\n        fieldName in resource.data &&\n        fieldName in request.resource.data &&\n        request.resource.data[fieldName] == resource.data[fieldName]\n      );\n    }\n\n    function userHasOrganizationRole(userId) {\n      return exists(/databases/$(database)/documents/users/$(userId)) &&\n        userDoc(userId).data.role == 'organization';\n    }\n\n    function subscriptionDoc(userId) {\n      return get(\n        /databases/$(database)/documents/users/$(userId)/subscriptions/current\n      );\n    }\n\n    function hasEligibleEventPlan(userId) {\n      return exists(\n          /databases/$(database)/documents/users/$(userId)/subscriptions/current\n        ) &&\n        (\n          subscriptionDoc(userId).data.planLevel == 'organization_basic' ||\n          subscriptionDoc(userId).data.planLevel == 'organization_premium'\n        ) &&\n        (\n          subscriptionDoc(userId).data.status == 'active' ||\n          subscriptionDoc(userId).data.status == 'trial'\n        );\n    }\n\n    function isValidCategory(category) {\n      return category == 'fishing' ||\n        category == 'event' ||\n        category == 'sighting' ||\n        category == 'weather';\n    }\n\n    function isValidDisplayCategory(category) {\n      return category == 'food' ||\n        category == 'coffee' ||\n        category == 'study' ||\n        category == 'outdoors' ||\n        category == 'fishing' ||\n        category == 'camping' ||\n        category == 'events' ||\n        category == 'family' ||\n        category == 'sights';\n    }\n\n    function isValidReportReason(reason) {\n      return reason == 'spam' ||\n        reason == 'misleading' ||\n        reason == 'offensive' ||\n        reason == 'unsafe' ||\n        reason == 'other';\n    }\n\n    function isValidReportStatus(status) {\n      return status == 'open' ||\n        status == 'reviewed' ||\n        status == 'dismissed' ||\n        status == 'action_taken';\n    }\n\n    function isValidPlanLevel(level) {\n      return level == 'free' ||\n        level == 'organization_basic' ||\n        level == 'organization_premium';\n    }\n\n    function isValidPlanStatus(status) {\n      return status == 'active' ||\n        status == 'inactive' ||\n        status == 'trial';\n    }\n\n    function isValidNotificationType(type) {\n      return type == 'comment_on_post' || type == 'like_on_post';\n    }\n\n    function isValidEventStatus(status) {\n      return status == 'active' ||\n        status == 'hidden' ||\n        status == 'cancelled';\n    }\n\n    function postDoc(postId) {\n      return get(/databases/$(database)/documents/posts/$(postId));\n    }\n\n    function postExists(postId) {\n      return exists(/databases/$(database)/documents/posts/$(postId));\n    }\n\n    function commentExists(postId, commentId) {\n      return exists(\n        /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)\n      );\n    }\n\n    function reactionExists(postId, userId) {\n      return exists(\n        /databases/$(database)/documents/posts/$(postId)/reactions/$(userId)\n      );\n    }\n\n    function isOwnerControlledPostUpdate() {\n      return request.resource.data.userId == resource.data.userId &&\n        request.resource.data.lat == resource.data.lat &&\n        request.resource.data.lng == resource.data.lng &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'text',\n          'category',\n          'displayCategory',\n          'locationName',\n          'updatedAt'\n        ]) &&\n        request.resource.data.text is string &&\n        request.resource.data.text.size() > 0 &&\n        request.resource.data.text.size() <= 280 &&\n        (request.resource.data.category == null ||\n          isValidCategory(request.resource.data.category)) &&\n        (\n          !('displayCategory' in request.resource.data) ||\n          request.resource.data.displayCategory == null ||\n          isValidDisplayCategory(request.resource.data.displayCategory)\n        );\n    }\n\n    function isAdminModerationPostUpdate() {\n      return request.resource.data.userId == resource.data.userId &&\n        request.resource.data.lat == resource.data.lat &&\n        request.resource.data.lng == resource.data.lng &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'isHidden',\n          'moderationStatus'\n        ]) &&\n        request.resource.data.isHidden == true &&\n        request.resource.data.moderationStatus == 'hidden';\n    }\n\n    function isOwnerControlledCommentUpdate() {\n      return request.resource.data.userId == resource.data.userId &&\n        request.resource.data.authorLabel == resource.data.authorLabel &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'text',\n          'updatedAt'\n        ]) &&\n        request.resource.data.text is string &&\n        request.resource.data.text.size() > 0 &&\n        request.resource.data.text.size() <= 500;\n    }\n\n    function isAdminModerationCommentUpdate() {\n      return request.resource.data.userId == resource.data.userId &&\n        request.resource.data.authorLabel == resource.data.authorLabel &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'isHidden',\n          'moderationStatus'\n        ]) &&\n        request.resource.data.isHidden == true &&\n        request.resource.data.moderationStatus == 'hidden';\n    }\n\n    match /users/{userId} {\n      allow read: if isSelfOrAdmin(userId);\n\n      allow create: if isSelf(userId) &&\n        request.resource.data.keys().hasOnly([\n          'id',\n          'email',\n          'role',\n          'xp',\n          'badgeKeys',\n          'username',\n          'bio',\n          'language',\n          'privacyMode',\n          'emailNotifications',\n          'marketingEmails',\n          'createdAt',\n          'updatedAt'\n        ]) &&\n        request.resource.data.id == userId &&\n        request.resource.data.role == 'user' &&\n        request.resource.data.xp == 0 &&\n        request.resource.data.badgeKeys is list &&\n        (\n          request.resource.data.language == 'en' ||\n          request.resource.data.language == 'ar'\n        ) &&\n        request.resource.data.privacyMode is bool &&\n        request.resource.data.emailNotifications is bool &&\n        request.resource.data.marketingEmails is bool;\n\n      allow update: if (\n          isSelf(userId) &&\n          request.resource.data.id == resource.data.id &&\n          request.resource.data.email == resource.data.email &&\n          request.resource.data.role == resource.data.role &&\n          request.resource.data.xp == resource.data.xp &&\n          request.resource.data.badgeKeys == resource.data.badgeKeys &&\n          request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'username',\n            'bio',\n            'language',\n            'privacyMode',\n            'emailNotifications',\n            'marketingEmails',\n            'updatedAt'\n          ]) &&\n          (\n            request.resource.data.language == 'en' ||\n            request.resource.data.language == 'ar'\n          )\n        ) || (\n          isAdmin() &&\n          request.resource.data.id == resource.data.id &&\n          request.resource.data.email == resource.data.email &&\n          request.resource.data.xp == resource.data.xp &&\n          request.resource.data.badgeKeys == resource.data.badgeKeys &&\n          request.resource.data.username == resource.data.username &&\n          request.resource.data.bio == resource.data.bio &&\n          request.resource.data.language == resource.data.language &&\n          request.resource.data.privacyMode == resource.data.privacyMode &&\n          optionalFieldUnchanged('emailNotifications') &&\n          optionalFieldUnchanged('marketingEmails') &&\n          request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'role',\n            'updatedAt'\n          ]) &&\n          (\n            request.resource.data.role == 'user' ||\n            request.resource.data.role == 'admin' ||\n            request.resource.data.role == 'organization'\n          )\n        );\n\n      allow delete: if false;\n\n      match /favorites/{postId} {\n        allow read: if isSelfOrAdmin(userId);\n        allow create: if isSelf(userId) &&\n          postExists(postId) &&\n          request.resource.data.keys().hasOnly([\n            'userId',\n            'postId',\n            'createdAt'\n          ]) &&\n          request.resource.data.userId == userId &&\n          request.resource.data.postId == postId;\n        allow update: if false;\n        allow delete: if isSelf(userId);\n      }\n\n      match /notifications/{notificationId} {\n        allow read: if isSelfOrAdmin(userId);\n        allow create: if false;\n\n        allow update: if isSelf(userId) &&\n          request.resource.data.recipientUserId == resource.data.recipientUserId &&\n          request.resource.data.actorUserId == resource.data.actorUserId &&\n          request.resource.data.actorLabel == resource.data.actorLabel &&\n          request.resource.data.type == resource.data.type &&\n          request.resource.data.postId == resource.data.postId &&\n          request.resource.data.commentId == resource.data.commentId &&\n          request.resource.data.message == resource.data.message &&\n          request.resource.data.createdAt == resource.data.createdAt &&\n          request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            'isRead',\n            'readAt'\n          ]) &&\n          request.resource.data.isRead == true;\n\n        allow delete: if false;\n      }\n\n      match /subscriptions/current {\n        allow read: if isSelfOrAdmin(userId);\n\n        allow create: if isSelf(userId) &&\n          request.resource.data.keys().hasOnly([\n            'userId',\n            'planLevel',\n            'status',\n            'createdAt',\n            'updatedAt'\n          ]) &&\n          request.resource.data.userId == userId &&\n          request.resource.data.planLevel == 'free' &&\n          request.resource.data.status == 'active';\n\n        allow update: if isAdmin() &&\n          request.resource.data.userId == userId &&\n          isValidPlanLevel(request.resource.data.planLevel) &&\n          isValidPlanStatus(request.resource.data.status);\n\n        allow delete: if false;\n      }\n\n      match /xpEvents/{eventId} {\n        allow read: if isSelfOrAdmin(userId);\n        allow write: if false;\n      }\n    }\n\n    match /posts/{postId} {\n      allow read: if isSignedIn();\n\n      allow create: if isSignedIn() &&\n        request.resource.data.keys().hasOnly([\n          'userId',\n          'title',\n          'text',\n          'category',\n          'displayCategory',\n          'lat',\n          'lng',\n          'placeId',\n          'heroImageUrl',\n          'locationName',\n          'createdAt'\n        ]) &&\n        request.resource.data.userId == request.auth.uid &&\n        request.resource.data.title is string &&\n        request.resource.data.title.size() > 0 &&\n        request.resource.data.title.size() <= 80 &&\n        request.resource.data.text is string &&\n        request.resource.data.text.size() > 0 &&\n        request.resource.data.text.size() <= 280 &&\n        (request.resource.data.category == null ||\n          isValidCategory(request.resource.data.category)) &&\n        (\n          !('displayCategory' in request.resource.data) ||\n          request.resource.data.displayCategory == null ||\n          isValidDisplayCategory(request.resource.data.displayCategory)\n        ) &&\n        request.resource.data.lat is number &&\n        request.resource.data.lng is number &&\n        (\n          !('placeId' in request.resource.data) ||\n          request.resource.data.placeId == null ||\n          request.resource.data.placeId is string\n        ) &&\n        (\n          !('heroImageUrl' in request.resource.data) ||\n          request.resource.data.heroImageUrl == null ||\n          request.resource.data.heroImageUrl is string\n        ) &&\n        (\n          request.resource.data.locationName == null ||\n          request.resource.data.locationName is string\n        );\n\n      allow update: if (\n          isSignedIn() &&\n          resource.data.userId == request.auth.uid &&\n          isOwnerControlledPostUpdate()\n        ) || (\n          isAdmin() && isAdminModerationPostUpdate()\n        );\n\n      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;\n\n      match /comments/{commentId} {\n        allow read: if isSignedIn();\n\n        allow create: if isSignedIn() &&\n          request.resource.data.keys().hasOnly([\n            'userId',\n            'authorLabel',\n            'text',\n            'createdAt'\n          ]) &&\n          request.resource.data.userId == request.auth.uid &&\n          request.resource.data.authorLabel is string &&\n          request.resource.data.authorLabel.size() > 0 &&\n          request.resource.data.authorLabel.size() <= 60 &&\n          request.resource.data.text is string &&\n          request.resource.data.text.size() > 0 &&\n          request.resource.data.text.size() <= 500;\n\n        allow update: if (\n            isSignedIn() &&\n            resource.data.userId == request.auth.uid &&\n            isOwnerControlledCommentUpdate()\n          ) || (\n            isAdmin() && isAdminModerationCommentUpdate()\n          );\n\n        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;\n      }\n\n      match /reactions/{userId} {\n        allow read: if isSignedIn();\n\n        allow create: if isSelf(userId) &&\n          request.resource.data.keys().hasOnly([\n            'postId',\n            'userId',\n            'type',\n            'createdAt'\n          ]) &&\n          request.resource.data.postId == postId &&\n          request.resource.data.userId == userId &&\n          request.resource.data.type == 'like';\n\n        allow update: if isSelf(userId) &&\n          request.resource.data.keys().hasOnly([\n            'postId',\n            'userId',\n            'type',\n            'createdAt'\n          ]) &&\n          request.resource.data.postId == resource.data.postId &&\n          request.resource.data.userId == resource.data.userId &&\n          request.resource.data.type == 'like';\n\n        allow delete: if isSelf(userId);\n      }\n    }\n\n    match /events/{eventId} {\n      allow read: if isSignedIn();\n      allow create, update, delete: if false;\n    }\n\n    match /reports/{reportId} {\n      allow read: if isAdmin();\n\n      allow create: if isSignedIn() &&\n        request.resource.data.keys().hasOnly([\n          'reporterUserId',\n          'targetType',\n          'targetId',\n          'targetPostId',\n          'reason',\n          'note',\n          'status',\n          'createdAt'\n        ]) &&\n        request.resource.data.reporterUserId == request.auth.uid &&\n        (\n          request.resource.data.targetType == 'post' ||\n          request.resource.data.targetType == 'comment'\n        ) &&\n        isValidReportReason(request.resource.data.reason) &&\n        request.resource.data.status == 'open' &&\n        (\n          request.resource.data.note == null ||\n          (\n            request.resource.data.note is string &&\n            request.resource.data.note.size() <= 300\n          )\n        ) &&\n        (\n          request.resource.data.targetType == 'post' ?\n            postExists(request.resource.data.targetId) &&\n            request.resource.data.targetPostId == null\n          :\n            request.resource.data.targetPostId is string &&\n            commentExists(\n              request.resource.data.targetPostId,\n              request.resource.data.targetId\n            )\n        );\n\n      allow update: if isAdmin() &&\n        request.resource.data.reporterUserId == resource.data.reporterUserId &&\n        request.resource.data.targetType == resource.data.targetType &&\n        request.resource.data.targetId == resource.data.targetId &&\n        request.resource.data.targetPostId == resource.data.targetPostId &&\n        request.resource.data.reason == resource.data.reason &&\n        request.resource.data.note == resource.data.note &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'status',\n          'updatedAt'\n        ]) &&\n        isValidReportStatus(request.resource.data.status);\n\n      allow delete: if false;\n    }\n\n    match /{path=**}/comments/{commentId} {\n      allow read: if isSignedIn();\n    }\n\n    match /{path=**}/reactions/{userId} {\n      allow read: if isSignedIn();\n    }\n\n    match /{path=**}/notifications/{notificationId} {\n      allow read: if isAdmin();\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-06T10:52:28.961759Z","metadata":{"services":["cloud.firestore"]}}
