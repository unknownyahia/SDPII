[debug] [2026-04-27T00:52:21.789Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/spots-42d51/rulesets {"name":"projects/spots-42d51/rulesets/8d25899b-e3aa-4a44-9cf3-387ecc900682","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function userDoc(userId) {\n      return get(/databases/$(database)/documents/users/$(userId));\n    }\n\n    function currentUserDoc() {\n      return userDoc(request.auth.uid);\n    }\n\n    function isSelf(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function isAdmin() {\n      return isSignedIn() && currentUserDoc().data.role == 'admin';\n    }\n\n    function isSelfOrAdmin(userId) {\n      return isSelf(userId) || isAdmin();\n    }\n\n    function optionalFieldUnchanged(fieldName) {\n      return (\n        !(fieldName in resource.data) &&\n        !(fieldName in request.resource.data)\n      ) || (\n        fieldName in resource.data &&\n        fieldName in request.resource.data &&\n        request.resource.data[fieldName] == resource.data[fieldName]\n      );\n    }\n\n    function userHasOrganizationRole(userId) {\n      return exists(/databases/$(database)/documents/users/$(userId)) &&\n        userDoc(userId).data.role == 'organization';\n    }\n\n    function subscriptionDoc(userId) {\n      return get(\n        /databases/$(database)/documents/users/$(userId)/subscriptions/current\n      );\n    }\n\n    function hasEligibleEventPlan(userId) {\n      return exists(\n          /databases/$(database)/documents/users/$(userId)/subscriptions/current\n        ) &&\n        (\n          subscriptionDoc(userId).data.planLevel == 'organization_basic' ||\n          subscriptionDoc(userId).data.planLevel == 'organization_premium'\n        ) &&\n        (\n          subscriptionDoc(userId).data.status == 'active' ||\n          subscriptionDoc(userId).data.status == 'trial'\n        );\n    }\n\n    function isValidCategory(category) {\n      return category == 'fishing' ||\n        category == 'event' ||\n        category == 'sighting' ||\n        category == 'weather';\n    }\n\n    function isValidDisplayCategory(category) {\n      return category == 'food' ||\n        category == 'coffee' ||\n        category == 'study' ||\n        category == 'outdoors' ||\n        category == 'fishing' ||\n        category == 'camping' ||\n        category == 'events' ||\n        category == 'family' ||\n        category == 'sights';\n    }\n\n    function isValidReportReason(reason) {\n      return reason == 'spam' ||\n        reason == 'misleading' ||\n        reason == 'offensive' ||\n        reason == 'unsafe' ||\n        reason == 'other';\n    }\n\n    function isValidReportStatus(status) {\n      return status == 'open' ||\n        status == 'reviewed' ||\n        status == 'dismissed' ||\n        status == 'action_taken';\n    }\n\n    function isValidPlanLevel(level) {\n      return level == 'free' ||\n        level == 'organization_basic' ||\n        level == 'organization_premium';\n    }\n\n    function isValidPlanStatus(status) {\n      return status == 'active' ||\n        status == 'inactive' ||\n        status == 'trial';\n    }\n\n    function isValidNotificationType(type) {\n      return type == 'comment_on_post' || type == 'like_on_post';\n    }\n\n    function isValidEventStatus(status) {\n      return status == 'active' ||\n        status == 'hidden' ||\n        status == 'cancelled';\n    }\n\n    function postDoc(postId) {\n      return get(/databases/$(database)/documents/posts/$(postId));\n    }\n\n    function postExists(postId) {\n      return exists(/databases/$(database)/documents/posts/$(postId));\n    }\n\n    function commentExists(postId, commentId) {\n      return exists(\n        /databases/$(database)/documents/posts/$(postId)/comments/$(commentId)\n      );\n    }\n\n    function reactionExists(postId, userId) {\n      return exists(\n        /databases/$(database)/documents/posts/$(postId)/reactions/$(userId)\n      );\n    }\n\n    function isOwnerControlledPostUpdate() {\n      return request.resource.data.userId == resource.data.userId &&\n        request.resource.data.lat == resource.data.lat &&\n        request.resource.data.lng == resource.data.lng &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'text',\n          'category',\n          'displayCategory',\n          'locationName',\n          'updatedAt'\n        ]) &&\n        request.resource.data.text is string &&\n        request.resource.data.text.size() > 0 &&\n        request.resource.data.text.size() <= 280 &&\n        (request.resource.data.category == null ||\n          isValidCategory(request.resource.data.category)) &&\n        (\n          !('displayCategory' in request.resource.data) ||\n          request.resource.data.displayCategory == null ||\n          isValidDisplayCategory(request.resource.data.displayCategory)\n        );\n    }\n\n    function isAdminModerationPostUpdate() {\n      return request.resource.data.userId == resource.data.userId &&\n        request.resource.data.lat == resource.data.lat &&\n        request.resource.data.lng == resource.data.lng &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'isHidden',\n          'moderationStatus'\n        ]) &&\n        request.resource.data.isHidden == true &&\n        request.resource.data.moderationStatus == 'hidden';\n    }\n\n    function isOwnerControlledCommentUpdate() {\n      return request.resource.data.userId == resource.data.userId &&\n        request.resource.data.authorLabel == resource.data.authorLabel &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'text',\n          'updatedAt'\n        ]) &&\n        request.resource.data.text is string &&\n        request.resource.data.text.size() > 0 &&\n        request.resource.data.text.size() <= 500;\n    }\n\n    function isAdminModerationCommentUpdate() {\n      return request.resource.data.userId == resource.data.userId &&\n        request.resource.data.authorLabel == resource.data.authorLabel &&\n        request.resource.data.createdAt == resource.data.createdAt &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'isHidden',\n          'moderationStatus'\n        ]) &&\n        request.resource.data.isHidden == true &&\n        request.resource.data.moderationStatus == 'hidden';\n    }\n\n    match /users/{userId} {\n      allow read: if isSelfOrAdmin(userId);\n\n      allow create: if isSelf(userId) &&\n        request.resource.data.keys().hasOnly([\n          'id',\n          'email',\n          'role',\n          'xp',\n          'badgeKeys',\n          'username',\n          'bio',\n          'language',\n          'privacyMode',\n          'emailNotifications',\n          'marketingEmails',\n          'createdAt',\n          'updatedAt'\n        ]) &&\n        request.resource.data.id == userId &&\n        request.resource.data.role == 'user' &&\n        request.resource.data.xp == 0 &&\n        request.resource.data.badgeKeys is list &&\n        (\n          request.resource.data.language == 'en' ||\n          request.resource.data.language == 'ar'\n        ) &&\n        request.resource.data.privacyMode is bool &&\n        request.resource.data.emailNotifications is bool &&\n        request.resource.data.marketingEmails is bool;\n\n      allow update: if (\n          isSelf(userId) &&\n          request.resource.data.id == resource.data.id &&\n          request.resource.data.email == resource.data.email &&\n          reque